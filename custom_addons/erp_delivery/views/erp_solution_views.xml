<odoo>
    <record id="view_erp_solution_category_list" model="ir.ui.view">
        <field name="name">erp.solution.category.list</field>
        <field name="model">erp.solution.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="action_erp_solution_category" model="ir.actions.act_window">
        <field name="name">Solution Categories</field>
        <field name="res_model">erp.solution.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_erp_solution_list" model="ir.ui.view">
        <field name="name">erp.solution.list</field>
        <field name="model">erp.solution</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="standard_effort"/>
                <field name="service_price"/>
                <field name="internal_cost" widget="monetary" options="{'currency_field': 'currency_id'}" groups="erp_delivery.group_erp_delivery_manager"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_erp_solution_kanban" model="ir.ui.view">
        <field name="name">erp.solution.kanban</field>
        <field name="model">erp.solution</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image">
                            <img t-att-src="kanban_image('erp.solution', 'image', record.id.raw_value)" alt="Solution"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong><field name="name"/></strong>
                            <div><field name="category_id"/></div>
                            <div><field name="service_price"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_erp_solution_form" model="ir.ui.view">
        <field name="name">erp.solution.form</field>
        <field name="model">erp.solution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="standard_effort"/>
                            <field name="service_price"/>
                            <field name="internal_cost" widget="monetary" options="{'currency_field': 'currency_id'}" groups="erp_delivery.group_erp_delivery_manager"/>
                        </group>
                    </group>
                    <group>
                        <field name="description_short"/>
                        <field name="description_rich"/>
                        <field name="document_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_erp_solution_search" model="ir.ui.view">
        <field name="name">erp.solution.search</field>
        <field name="model">erp.solution</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_erp_solution" model="ir.actions.act_window">
        <field name="name">Solutions</field>
        <field name="res_model">erp.solution</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
