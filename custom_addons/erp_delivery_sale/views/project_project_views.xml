<odoo>
    <record id="view_project_project_form_erp_delivery_sale" model="ir.ui.view">
        <field name="name">project.project.form.erp.delivery.sale</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_erp_source_sale_order"
                        icon="fa-file-text-o" invisible="not erp_sale_order_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Source Sale Order</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
